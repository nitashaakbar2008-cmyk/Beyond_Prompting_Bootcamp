# Copy this file to ".env" and fill in your own values. NEVER commit ".env" or share these keys.
# All values below are placeholders.

# --- AI assistant (required for the live chatbot) ---
ANTHROPIC_API_KEY=paste-your-anthropic-api-key-here
# Model name: confirm the current name in the Anthropic Console / docs before use.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Dev server port for server-with-ai.mjs (optional) ---
PORT=5174

# --- Shared database (optional; only if you set up Supabase, see docs/database-setup.md) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=paste-your-supabase-anon-public-key-here
# SERVER ONLY. Never put this in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=paste-your-supabase-service-role-key-here
